# ============================================================================
# Student Placement & Internship Management System (CareerTrack)
# Backend Environment Configuration Template
# ============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# Never commit your actual '.env' to version control!
# ============================================================================

# Flask Application Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-strong-random-secret-key-in-production

# Database Configuration (MySQL 8.0)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>?charset=utf8mb4
DB_USER=careertrack_user
DB_PASSWORD=YOUR_CAREERTRACK_PASSWORD_HERE
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=careertrack_db

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# Session Configuration (HTTP-only Cookie Authentication)
SESSION_COOKIE_NAME=careertrack_session
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=86400
